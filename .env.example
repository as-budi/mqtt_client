# Salin menjadi ".env" lalu sesuaikan. File .env TIDAK di-commit.
DJANGO_SECRET_KEY=ganti-dengan-teks-acak-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL: database TERPISAH dari IoT Platform.
DB_NAME=mqttc
DB_USER=mqttc_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# IoT Platform sebagai penyedia login (OpenID Connect).
# Di laptop: platform berjalan di port 8000, aplikasi ini di port 9000:
#   python manage.py runserver 127.0.0.1:9000
PLATFORM_URL=http://127.0.0.1:8000
# Kosong = PLATFORM_URL + /o
OIDC_ISSUER=
# Dari platform: python manage.py oauth_client "MQTT Client (dev)" --redirect-uri http://127.0.0.1:9000/oidc/callback/ --logout-uri http://127.0.0.1:9000/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=


