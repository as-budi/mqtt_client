# Salin menjadi ".env" lalu sesuaikan. File .env TIDAK di-commit.
DJANGO_SECRET_KEY=ganti-dengan-teks-acak-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL: database TERPISAH dari IoT Platform.
DB_NAME=mqttc
DB_USER=mqttc_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# IoT Platform sebagai penyedia login (OpenID Connect).
# Di laptop: platform berjalan di port 8000, aplikasi ini di port 9000:
#   python manage.py runserver 127.0.0.1:9000
PLATFORM_URL=http://127.0.0.1:8000
# Kosong = PLATFORM_URL + /o
OIDC_ISSUER=
# Broker IoT Platform untuk browser (templat "IoT Platform broker"). Di server:
# wss://iot.reslab-csub.cloud/mqtt. Di laptop biasanya kosong (templat disembunyikan).
PLATFORM_MQTT_WS_URL=
# Dari platform: python manage.py oauth_client "MQTT Client (dev)" --redirect-uri http://127.0.0.1:9000/oidc/callback/ --logout-uri http://127.0.0.1:9000/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Relay WebSocket -> TCP untuk broker mqtt:// dan mqtts:// (tahap M4). Jalankan: python -m relay
# Alamat relay untuk browser (diakhiri /). Kosong = relay tidak dipakai.
RELAY_PUBLIC_URL=ws://127.0.0.1:8003/relay/
# Rahasia bersama Django <-> relay, 32+ karakter acak:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SHARED_SECRET=
RELAY_PORT=8003
RELAY_REDEEM_URL=http://127.0.0.1:9000/internal/relay/redeem/
RELAY_REPORT_URL=http://127.0.0.1:9000/internal/relay/report/
RELAY_ALLOWED_PORTS=1883,8883
# True HANYA di laptop (boleh ke Mosquitto di localhost/LAN). Di server WAJIB False.
RELAY_ALLOW_LOCAL=True
