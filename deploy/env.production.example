# Contoh .env untuk SERVER (salin ke /srv/mqttc/app/.env, lalu: chmod 600 .env).
# Panduan lengkap: docs/deploy.md. Buat nilai acak dengan:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=GANTI-dengan-50-karakter-acak
DJANGO_DEBUG=False
# 127.0.0.1 WAJIB ada: relay memanggil Django langsung di http://127.0.0.1:8002/internal/...
DJANGO_ALLOWED_HOSTS=mqtt.reslab-csub.cloud,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://mqtt.reslab-csub.cloud
# Ubah ke True SETELAH sertifikat HTTPS terpasang (langkah 6 panduan).
DJANGO_HTTPS=False
DJANGO_HSTS_SECONDS=3600

# Database SENDIRI (bukan database IoT Platform), di MySQL yang sama.
DB_NAME=mqttc
DB_USER=mqttc_user
DB_PASSWORD=GANTI-password-database-acak
DB_HOST=localhost
DB_PORT=3306

# --- IoT Platform: login (OpenID Connect) dan API ---
PLATFORM_URL=https://iot.reslab-csub.cloud
# Kosong = PLATFORM_URL + /o (harus sama dengan OIDC_ISSUER di .env platform)
OIDC_ISSUER=
# Dari platform (langkah 4 panduan):
#   manage.py oauth_client "MQTT Client" --redirect-uri https://mqtt.reslab-csub.cloud/oidc/callback/ \
#       --logout-uri https://mqtt.reslab-csub.cloud/
# client_secret hanya tampil SEKALI. Jangan ditempel di chat, email, atau dokumentasi.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Broker platform untuk browser (= MQTT_PUBLIC_WS_URL di .env platform)
PLATFORM_MQTT_WS_URL=wss://iot.reslab-csub.cloud/mqtt
PLATFORM_TIMEOUT=10

# --- Relay WebSocket -> TCP (broker mqtt:// dan mqtts://) ---
RELAY_PUBLIC_URL=wss://mqtt.reslab-csub.cloud/relay/
# 32+ karakter acak; dipakai Django DAN relay (file .env yang sama)
RELAY_SHARED_SECRET=GANTI-dengan-32-karakter-acak
RELAY_BIND=127.0.0.1
RELAY_PORT=8003
RELAY_REDEEM_URL=http://127.0.0.1:8002/internal/relay/redeem/
RELAY_REPORT_URL=http://127.0.0.1:8002/internal/relay/report/
RELAY_ALLOWED_PORTS=1883,8883
# Hanya halaman aplikasi ini yang boleh membuka relay
RELAY_ORIGINS=https://mqtt.reslab-csub.cloud
# WAJIB False di server: relay tidak boleh menjangkau localhost/LAN (Mosquitto 1883, MySQL, ...)
RELAY_ALLOW_LOCAL=False
# Batas (bawaan): koneksi per pengguna, total, byte/detik per arah, detik diam, umur maksimum
RELAY_MAX_PER_USER=5
RELAY_MAX_TOTAL=200
RELAY_RATE_BYTES=65536
RELAY_IDLE_SECONDS=600
RELAY_MAX_SECONDS=43200
