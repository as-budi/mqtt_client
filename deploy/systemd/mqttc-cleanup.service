# Bersih-bersih harian: tiket relay lama + sesi kedaluwarsa (manage.py cleanup).
# Dijalankan mqttc-cleanup.timer.
[Unit]
Description=MQTT Client: delete old relay tickets and expired sessions
After=mysql.service

[Service]
Type=oneshot
User=mqttc
Group=mqttc
WorkingDirectory=/srv/mqttc/app
ExecStart=/srv/mqttc/venv/bin/python manage.py cleanup
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
